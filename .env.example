# MIZ OKI 3.5 marketing site — environment variable template
# Copy this to `.env` (gitignored) and edit values. Do NOT commit `.env`.

# ── Flask session ────────────────────────────────────────────────────────────
# 32-byte hex string. If left blank, a random key is generated at boot
# (sessions reset on every process restart — fine for dev, bad for prod).
SECRET_KEY=

# Set to "production" to flip session cookies to Secure (HTTPS-only).
ENVIRONMENT=development

# ── Admin / backend login ────────────────────────────────────────────────────
# JSON object of {email: password}. Anyone in this map can sign in at /admin
# and use the Boss runtime / MCP tool registry from the browser.
# WARNING: plaintext passwords — fine for an internal demo, replace with a
# real IdP (Okta, Google Workspace, etc.) before exposing to the internet.
#
# Default seed creds (overwrite before deploying anywhere public):
#   email:    admin@mizoki3.com
#   password: change-me-please
MIZOKI_DEMO_USERS_JSON={"admin@mizoki3.com":"change-me-please","ceo@mediaintelligence.ai":"change-me-please"}

# ── Boss runtime data dir (skills, aliases, traces) ──────────────────────────
# Optional. Defaults to a folder next to mizoki_runtime/.
# MIZOKI_DATA_DIR=/var/lib/mizoki

# ── External dashboard (the cell of the Boss agent in prod) ──────────────────
# These are baked into app.py as constants today; uncomment to override.
# EXTERNAL_LOGIN_URL=https://mizoki.mizoki3.com/login
# EXTERNAL_DASHBOARD_URL=https://mizoki.mizoki3.com/dashboard

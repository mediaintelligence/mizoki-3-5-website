# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Dependencies
node_modules/
vendor/

# Build
dist/
build/

# Environment
.env
.env.*
!.env.example

# Logs
*.log

# Docker
.docker/

# Local Claude Code settings
.claude/

# Scratch / non-website content (legal docs, generated PDFs, working notes)
tmp/
output/

# Runtime ledgers — data/ ships EMPTY (.gitkeep only). These files are written
# by the running app (guide memory, demo telemetry, decision traces); a
# committed copy would bake local/test rows into the production image and
# pre-pollute the interaction analytics.
data/*.jsonl
!data/.gitkeep

# Visual QA captures — only the reviewed 1440px set is tracked
scripts/screenshots/*
!scripts/screenshots/*-1440.png
